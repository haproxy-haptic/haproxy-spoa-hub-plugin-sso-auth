# Cross-compile for armv7 from amd64 using Debian Bookworm.
# This gives us the same glibc (2.36) and OpenSSL (3.x) as the
# amd64/arm64 builds.
FROM rust:1.96-bookworm

ARG CARGO_AUDITABLE_VERSION=0.7.4

RUN dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc-arm-linux-gnueabihf \
        libxml2-dev:armhf \
        libxmlsec1-dev:armhf \
        libxmlsec1-openssl:armhf \
        libssl-dev:armhf \
        libclang-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN rustup target add armv7-unknown-linux-gnueabihf

# cargo-auditable embeds a compressed Cargo.lock-equivalent in the binary
# so syft + grype can enumerate Rust deps from the published .so files
# without source access. 0.7.0+ required for Rust edition 2024.
RUN cargo install --locked "cargo-auditable@${CARGO_AUDITABLE_VERSION}"

# glibc's armhf bits/setjmp.h declares __jmp_buf with
# __attribute__((__aligned__(8))). bindgen cannot represent this
# on Rust typedefs, causing layout test mismatches. Patch the
# header since samael never uses __jmp_buf_tag directly.
COPY ci/armhf-setjmp-bindgen.patch /tmp/
RUN patch -p1 -d /usr/include/arm-linux-gnueabihf < /tmp/armhf-setjmp-bindgen.patch

# Redirect x86_64 multiarch headers to armhf so libclang picks up
# the correct arch-specific headers.
RUN rm -rf /usr/include/x86_64-linux-gnu && \
    ln -s arm-linux-gnueabihf /usr/include/x86_64-linux-gnu

ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc
ENV PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig
ENV PKG_CONFIG_ALLOW_CROSS=1

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
COPY specs/001-sso-auth-plugin/contracts/ specs/001-sso-auth-plugin/contracts/

RUN cargo auditable build --target armv7-unknown-linux-gnueabihf --release

FROM scratch
COPY --from=0 /build/target/armv7-unknown-linux-gnueabihf/release/libhaproxy_spoa_hub_plugin_sso_auth.so /
