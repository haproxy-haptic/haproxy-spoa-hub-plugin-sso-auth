Strip __aligned__(8) from armhf __jmp_buf typedef.

bindgen cannot represent C alignment attributes on Rust typedefs,
causing layout test mismatches when cross-compiling for armv7
(libclang sees 8-byte alignment -> size 392, rustc sees 4-byte -> 388).
samael never uses __jmp_buf_tag directly, so the attribute is not
needed for correct bindings.

--- a/bits/setjmp.h
+++ b/bits/setjmp.h
@@ -31,6 +31,6 @@
    Library ABI requires that the buffer be 8-byte aligned, and
    recommends that the buffer contain 64 words.  The first 26 words
    are occupied by sp, lr, v1-v6, sl, fp, and d8-d15.  */
-typedef int __jmp_buf[64] __attribute__((__aligned__ (8)));
+typedef int __jmp_buf[64];
 #endif

